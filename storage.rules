// ════════════════════════════════════════════════
//  Storage Rules — Just Rodyy Forever
//  Paste in Firebase Console → Storage → Rules
// ════════════════════════════════════════════════

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
